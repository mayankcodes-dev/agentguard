# ─── MongoDB Atlas ────────────────────────────────────────────────────────────
# Get free cluster at https://mongodb.com/atlas
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>
# Example: mongodb+srv://mayank:mypassword@cluster0.abc12.mongodb.net/agentguard
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/agentguard

# ─── Upstash Redis ────────────────────────────────────────────────────────────
# Get free Redis at https://upstash.com (can reuse existing instance — different DB name is fine)
# IMPORTANT: Use the rediss:// URL (with double s) for TLS — NOT redis://
REDIS_URL=rediss://default:your-token@your-endpoint.upstash.io:6379

# Upstash REST (used by some SDK methods)
UPSTASH_REDIS_REST_URL=https://your-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-rest-token

# ─── Google Gemini API ────────────────────────────────────────────────────────
# FREE tier at https://aistudio.google.com/app/apikey
# gemini-1.5-flash is free: 15 requests/min, 1M tokens/day
GEMINI_API_KEY=AIza...

# ─── Clerk Auth ───────────────────────────────────────────────────────────────
# Get keys at https://dashboard.clerk.com → Your App → API Keys
# Enable Email + Google OAuth in Clerk Dashboard → User & Authentication → Social Connections
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ─── API URLs ─────────────────────────────────────────────────────────────────
# Local dev
NEXT_PUBLIC_API_URL=http://localhost:3001
API_URL=http://localhost:3001

# Production (set these in Vercel/Railway dashboard)
# NEXT_PUBLIC_API_URL=https://your-api.railway.app
# API_URL=https://your-api.railway.app

# ─── Misc ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
PROXY_PORT=9000
